#!/bin/sh
# Starts Unreal Speccy Portable (SDL2 desktop variant)
# Binary + res/ live under /usr/lib/unreal-speccy-portable-sdl2-desktop/
# so relative paths like res/rom/*.rom resolve correctly.

BIN_PATH=/usr/lib/unreal-speccy-portable-sdl2-desktop/

cd "${BIN_PATH}" || exit 1
exec "${BIN_PATH}unreal_speccy_portable" "$@"
