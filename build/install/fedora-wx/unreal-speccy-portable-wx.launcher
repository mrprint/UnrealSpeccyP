#!/bin/sh
# Starts Unreal Speccy Portable (wxWidgets variant)
# Binary + res/ live under /usr/lib/unreal-speccy-portable-wx/
# so relative paths like res/rom/*.rom resolve correctly.

BIN_PATH=/usr/lib/unreal-speccy-portable-wx/

cd "${BIN_PATH}" || exit 1
exec "${BIN_PATH}unreal_speccy_portable" "$@"
